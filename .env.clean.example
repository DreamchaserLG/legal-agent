APP_NAME=Legal Demo MVP
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# PostgreSQL is recommended for pgvector. For a quick SQLite-only run, replace with:
# DATABASE_URL=sqlite:///./data/legal_demo.sqlite3
DATABASE_URL=postgresql+psycopg2://postgres:change_me@127.0.0.1:5432/legal_demo
SESSION_SECRET=replace-with-a-long-random-string
SESSION_MAX_AGE_SECONDS=604800

REQUEST_TIMEOUT=30
LLM_TIMEOUT=90
LLM_RETRY_COUNT=2
LLM_RETRY_BACKOFF_MS=800
LLM_CIRCUIT_BREAKER_SECONDS=120
CACHE_TTL_SECONDS=300

ANALYSIS_LOCAL_FAST_MODE=true
PREDICTION_LOCAL_FAST_MODE=true
PREDICTION_USE_MODEL_CASE_COMPARISON=false
RELIABLE_ANSWER_MODE=true
RELIABLE_MIN_SUPPORT_ITEMS=1
RELIABLE_MAX_CONFIDENCE_WITHOUT_CASES=0.25

REMOTE_SEARCH_ENABLED=true
ASYNC_HYDRATION_ENABLED=true
REMOTE_SEARCH_TRIGGER_COUNT=1
REMOTE_SEARCH_MAX_ITEMS_PER_SOURCE=12
ANALYSIS_NEW_CASE_HYDRATION_ENABLED=true
ANALYSIS_NEW_CASE_TARGET_COUNT=0
BILINGUAL_RESULT_PREVIEW_LIMIT=6
DEFAULT_SEARCH_LIMIT=30

RAG_ENABLED=true
RAG_CHUNK_SIZE=1800
RAG_CHUNK_OVERLAP=180
RAG_MAX_CONTEXT_ITEMS=8
RAG_HYBRID_ENABLED=true
RAG_LEXICAL_WEIGHT=0.55
RAG_VECTOR_WEIGHT=0.45
RAG_LEXICAL_CANDIDATE_LIMIT=40
RAG_VECTOR_CANDIDATE_LIMIT=40

# Option A: no external model, diagnostic only.
# EMBEDDING_PROVIDER=hash
# EMBEDDING_MODEL=local-hash-embedding
# EMBEDDING_DIMENSION=384

# Option B: local BGE-M3 semantic embedding.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_LOCAL_MODEL_PATH=D:\environment\embeddingModel\bge-m3
EMBEDDING_DEVICE=auto
EMBEDDING_MAX_LENGTH=2048
EMBEDDING_BATCH_SIZE=16
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

LOCAL_ARCHIVE_ENABLED=true
ARCHIVE_BOOTSTRAP_ENABLED=true
LOCAL_ARCHIVE_DIR=data_archive
LOCAL_ARCHIVE_EXPORT_DIR=data_archive/exports
DEMO_HISTORY_SEED_ENABLED=false

CANLII_DATABASE_PAGES=https://www.canlii.org/en/on/onca/,https://www.canlii.org/en/on/onsc/
CANLII_REMOTE_DATABASE_PAGE_LIMIT=80
CANLII_DATABASE_DISCOVERY_TTL_SECONDS=21600
CANLII_HTTP_PROXY=
CANLII_REQUEST_DELAY_SECONDS=2.0
CANLII_CASE_TEXT_CHAR_LIMIT=6000
CANLII_API_KEY=
CANLII_API_BASE_URL=http://api.canlii.org/v1
CANLII_API_PAGE_SIZE=100
CANLII_REALTIME_SEARCH_ENABLED=true
CANLII_REALTIME_SEARCH_MAX_ITEMS=20
KEYWORD_EXTRACTION_USE_LLM=false
PIPELINE_SEARCH_TIMEOUT_SECONDS=30
CANADA_FEDERAL_SYNC_MAX_ITEMS=0
ONTARIO_LEGISLATION_SYNC_MAX_ITEMS=0
ONTARIO_LEGISLATION_INCLUDE_FULL_TEXT=false

OFAC_FULL_SNAPSHOT_ENABLED=true
OFAC_SDN_CSV_URL=
OFAC_ADD_CSV_URL=
OFAC_ALT_CSV_URL=
OFAC_SDN_COMMENTS_CSV_URL=

# Choose one: spark, openai, custom.
LLM_PROVIDER=custom

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_REASONING_EFFORT=low

SPARK_API_KEY=
SPARK_API_SECRET=
SPARK_APP_ID=
SPARK_MODEL=Spark Ultra-32K
SPARK_DOMAIN=4.0Ultra
SPARK_BASE_URL=wss://spark-api.xf-yun.com/v4.0/chat
SPARK_TEMPERATURE=0.2

# OpenAI-compatible endpoint, for example Qwen, vLLM, LM Studio, or Xinference.
CUSTOM_API_KEY=
CUSTOM_MODEL=
CUSTOM_BASE_URL=http://127.0.0.1:8000/v1
CUSTOM_TEMPERATURE=0.3
CUSTOM_MAX_TOKENS=4096
CUSTOM_STRICT_JSON_MODE=true
CUSTOM_USE_LOCAL=false

INGESTION_WORKER_POLL_SECONDS=2
INGESTION_PAGE_POLL_SECONDS=3000
INGESTION_TASK_REQUEUE_COOLDOWN_SECONDS=900
INGESTION_WORKER_STALE_SECONDS=600
INGESTION_WORKER_NAME=

INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_EMAIL=

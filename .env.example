APP_NAME=Legal Demo MVP
APP_HOST=127.0.0.1
APP_PORT=8000

DATABASE_URL=postgresql+psycopg2://postgres:change_me@127.0.0.1:5432/legal_demo
SESSION_SECRET=replace-with-a-long-random-string

# BGE-M3 全自动案例分块向量迁移。DB_URL 为空时复用 DATABASE_URL，不需要人工确认。
DB_URL=
BATCH_SIZE=500
EMBEDDING_BATCH_SIZE=32
AUTO_APPROVE=TRUE
MIGRATION_LOG_PATH=logs/case_chunk_migration.jsonl
HF_HOME=data/model_cache/huggingface
# 默认自动探测 case_embeddings、legal_cases 和 rag_chunks；异构旧库可显式指定如下字段。
SOURCE_TABLE=
SOURCE_ID_COLUMN=id
SOURCE_CONTENT_COLUMN=content
SOURCE_CASE_NUMBER_COLUMN=case_number
SOURCE_COURT_COLUMN=court
SOURCE_DECISION_DATE_COLUMN=decision_date
# A2AJ 位于独立数据库时启用；ID 冲突时可设置 A2AJ_ID_OFFSET。
A2AJ_DB_URL=
A2AJ_SOURCE_TABLE=
A2AJ_ID_COLUMN=id
A2AJ_CONTENT_COLUMN=content
A2AJ_CASE_NUMBER_COLUMN=case_number
A2AJ_COURT_COLUMN=court
A2AJ_DECISION_DATE_COLUMN=decision_date
A2AJ_ID_OFFSET=0

REQUEST_TIMEOUT=30
LLM_TIMEOUT=90
LLM_RETRY_COUNT=2
LLM_RETRY_BACKOFF_MS=800
LLM_CIRCUIT_BREAKER_SECONDS=120
CACHE_TTL_SECONDS=300
PREDICTION_USE_MODEL_CASE_COMPARISON=false
SEARCH_FAST_RAG_ENABLED=true
ANALYSIS_FAST_LLM_KEYWORD_ENABLED=false
DEEP_ANALYSIS_ENABLED=false
DEEP_ANALYSIS_TIMEOUT_SECONDS=120
DEEP_ANALYSIS_MAX_LLM_CALLS=5
QUALITY_GATE_CITATION_TRACEABILITY_MIN=0.7
QUALITY_GATE_RULE_CURRENCY_MIN=0.8
QUALITY_GATE_EVIDENCE_COMPLETENESS_MIN=0.6
QUALITY_GATE_LOW_CONFIDENCE_RATIO_MAX=0.4
QUALITY_GATE_MANUAL_REVIEW_MAX=10
CASE_STRENGTH_WEIGHT_EVIDENCE=0.25
CASE_STRENGTH_WEIGHT_LEGAL_BASIS=0.25
CASE_STRENGTH_WEIGHT_CASE_SUPPORT=0.20
CASE_STRENGTH_WEIGHT_PROCEDURAL=0.15
CASE_STRENGTH_WEIGHT_OPPOSING=0.15
REMOTE_SEARCH_ENABLED=true
ASYNC_HYDRATION_ENABLED=true
REMOTE_SEARCH_TRIGGER_COUNT=1
REMOTE_SEARCH_MAX_ITEMS_PER_SOURCE=12
ANALYSIS_NEW_CASE_HYDRATION_ENABLED=true
ANALYSIS_NEW_CASE_TARGET_COUNT=0
BILINGUAL_RESULT_PREVIEW_LIMIT=6
RELIABLE_ANSWER_MODE=true
RELIABLE_MIN_SUPPORT_ITEMS=1
RELIABLE_MAX_CONFIDENCE_WITHOUT_CASES=0.25
RAG_ENABLED=true
# 法律 RAG 使用 BGE-M3 tokenizer 精确切分；旧字符长度配置仅为兼容保留。
RAG_CHUNK_SIZE_TOKENS=512
RAG_CHUNK_OVERLAP_TOKENS=64
RAG_MAX_CONTEXT_ITEMS=8
RAG_HYBRID_ENABLED=true
RAG_LEXICAL_WEIGHT=0.55
RAG_VECTOR_WEIGHT=0.45
RAG_LEXICAL_CANDIDATE_LIMIT=24
RAG_VECTOR_CANDIDATE_LIMIT=24
RAG_VECTOR_INDEX_TYPE=hnsw
RAG_HNSW_M=16
RAG_HNSW_EF_CONSTRUCTION=64
RAG_HNSW_EF_SEARCH=80
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_LOCAL_MODEL_PATH=
EMBEDDING_DEVICE=auto
EMBEDDING_MAX_LENGTH=8192
EMBEDDING_BATCH_SIZE=32
CANLII_BULK_SYNC_ENABLED=false
OFAC_FULL_SNAPSHOT_ENABLED=true
LOCAL_ARCHIVE_ENABLED=true
ARCHIVE_BOOTSTRAP_ENABLED=false
STARTUP_CANADA_SYNC_MODE=disabled
LOCAL_ARCHIVE_DIR=data_archive
LOCAL_ARCHIVE_EXPORT_DIR=data_archive/exports
DEMO_HISTORY_SEED_ENABLED=false
INGESTION_WORKER_POLL_SECONDS=2
INGESTION_PAGE_POLL_SECONDS=3000
INGESTION_TASK_REQUEUE_COOLDOWN_SECONDS=900
INGESTION_WORKER_STALE_SECONDS=600
INGESTION_WORKER_NAME=
DEFAULT_SEARCH_LIMIT=30
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_EMAIL=

CANLII_DATABASE_PAGES=https://www.canlii.org/en/on/onca/,https://www.canlii.org/en/on/onsc/
CANLII_REMOTE_DATABASE_PAGE_LIMIT=80
CANLII_DATABASE_DISCOVERY_TTL_SECONDS=21600
CANLII_HTTP_PROXY=
CANLII_REQUEST_DELAY_SECONDS=2.0
CANLII_CASE_TEXT_CHAR_LIMIT=6000
CANLII_API_KEY=
CANLII_API_BASE_URL=http://api.canlii.org/v1
CANLII_API_PAGE_SIZE=100

# CanLII 实时搜索 (用户提问时实时搜索CanLII)
CANLII_REALTIME_SEARCH_ENABLED=false
CANLII_REALTIME_SEARCH_MAX_ITEMS=20
# LLM关键词提取 (即使在fast模式下也用LLM提取法律关键词)
KEYWORD_EXTRACTION_USE_LLM=true
# 搜索管线超时
PIPELINE_SEARCH_TIMEOUT_SECONDS=30
CANADA_FEDERAL_SYNC_MAX_ITEMS=0
ONTARIO_LEGISLATION_SYNC_MAX_ITEMS=0
ONTARIO_LEGISLATION_INCLUDE_FULL_TEXT=false
CANADA_LEGISLATION_SOURCE=laws_lois_xml
CANADA_CASE_SOURCE=a2aj_hf
A2AJ_API_BASE_URL=https://api.a2aj.ca
A2AJ_HF_CASE_DATASET=a2aj/canadian-case-law
A2AJ_HF_LAW_DATASET=a2aj/canadian-laws
A2AJ_DEMO_CASE_CONFIGS=default
A2AJ_DEMO_LAW_CONFIGS=default
A2AJ_DEMO_CASES_PER_CONFIG=5
A2AJ_DEMO_LAWS_PER_CONFIG=5
LAWS_LOIS_XML_REPO_URL=https://github.com/justicecanada/laws-lois-xml.git
LAWS_LOIS_XML_LOCAL_DIR=data/imports/laws-lois-xml
LAWS_LOIS_XML_DEMO_LIMIT=10

OFAC_SDN_CSV_URL=
OFAC_ADD_CSV_URL=
OFAC_ALT_CSV_URL=
OFAC_SDN_COMMENTS_CSV_URL=

LLM_PROVIDER=custom

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_REASONING_EFFORT=low

SPARK_API_KEY=
SPARK_API_SECRET=
SPARK_APP_ID=
SPARK_MODEL=Spark Ultra-32K
SPARK_DOMAIN=4.0Ultra
SPARK_BASE_URL=wss://spark-api.xf-yun.com/v4.0/chat
SPARK_TEMPERATURE=0.2

# 自定义模型配置 (OpenAI-compatible API, 如 Qwen3)
CUSTOM_API_KEY=
CUSTOM_MODEL=qwen3.8-27b
CUSTOM_BASE_URL=https://llm-jf295og2fidcy3uz.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
CUSTOM_TEMPERATURE=0.1
CUSTOM_MAX_TOKENS=4096
CUSTOM_STRICT_JSON_MODE=true
# 本地模式: 模型服务在同一台机器时设为 true, 会使用 127.0.0.1:8000 忽略 CUSTOM_BASE_URL
CUSTOM_USE_LOCAL=false

APP_NAME=Foreign-related Legal AI
APP_ENV=production
APP_HOST=127.0.0.1
APP_PORT=8000
API_DOCS_ENABLED=false
ALLOWED_HOSTS=127.0.0.1,localhost

# Linux + SQLite deployment. Keep the database under the app directory.
DATABASE_URL=sqlite:///./data/legal_demo.sqlite3
SESSION_SECRET=replace-with-a-long-random-string
SESSION_MAX_AGE_SECONDS=604800

REQUEST_TIMEOUT=30
LLM_TIMEOUT=90
LLM_RETRY_COUNT=2
LLM_RETRY_BACKOFF_MS=800
LLM_CIRCUIT_BREAKER_SECONDS=120
CACHE_TTL_SECONDS=300

# Prediction defaults. Set PREDICTION_LOCAL_FAST_MODE=false if you want prediction to call the configured LLM.
ANALYSIS_LOCAL_FAST_MODE=true
DEEP_ANALYSIS_ENABLED=true
AGENTIC_LEGAL_RESEARCH_ENABLED=true
LEGAL_RESEARCH_MAX_ROUNDS=3
LEGAL_RESEARCH_QUERIES_PER_ROUND=6
LEGAL_RESEARCH_MAX_EVIDENCE=40
LEGAL_RESEARCH_MIN_NEW_EVIDENCE=2
LEGAL_RESEARCH_TIMEOUT_SECONDS=90
PREDICTION_LOCAL_FAST_MODE=true
PREDICTION_USE_MODEL_CASE_COMPARISON=false
RELIABLE_ANSWER_MODE=true
RELIABLE_MIN_SUPPORT_ITEMS=1
RELIABLE_MAX_CONFIDENCE_WITHOUT_CASES=0.25

REMOTE_SEARCH_ENABLED=false
ASYNC_HYDRATION_ENABLED=false
REMOTE_SEARCH_TRIGGER_COUNT=1
REMOTE_SEARCH_MAX_ITEMS_PER_SOURCE=12
ANALYSIS_NEW_CASE_HYDRATION_ENABLED=false
ANALYSIS_NEW_CASE_TARGET_COUNT=0
BILINGUAL_RESULT_PREVIEW_LIMIT=6
DEFAULT_SEARCH_LIMIT=10

RAG_ENABLED=true
RAG_CHUNK_SIZE=1800
RAG_CHUNK_OVERLAP=180
RAG_MAX_CONTEXT_ITEMS=8
RAG_HYBRID_ENABLED=true
RAG_LEXICAL_WEIGHT=0.55
RAG_VECTOR_WEIGHT=0.45
RAG_LEXICAL_CANDIDATE_LIMIT=24
RAG_VECTOR_CANDIDATE_LIMIT=24
RAG_CONTEXT_WINDOW_ENABLED=true
RAG_CONTEXT_WINDOW_RADIUS=1
RAG_CONTEXT_WINDOW_SEED_LIMIT=4
RAG_CONTEXT_WINDOW_MAX_CHUNKS=12
RAG_CONTEXT_WINDOW_TOKEN_BUDGET=8000
RAG_GRAPH_ENABLED=true
RAG_GRAPH_WEIGHT=0.25
RAG_GRAPH_CANDIDATE_LIMIT=20
RAG_GRAPH_MAX_HOPS=3
RAG_GRAPH_EDGE_MIN_CONFIDENCE=0.65
RAG_VECTOR_INDEX_TYPE=hnsw
RAG_HNSW_M=16
RAG_HNSW_EF_CONSTRUCTION=64
RAG_HNSW_EF_SEARCH=80
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=local-hash-embedding
EMBEDDING_DIMENSION=384
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_LOCAL_MODEL_PATH=
EMBEDDING_DEVICE=auto
EMBEDDING_MAX_LENGTH=8192
EMBEDDING_BATCH_SIZE=32

LOCAL_ARCHIVE_ENABLED=true
ARCHIVE_BOOTSTRAP_ENABLED=false
STARTUP_CANADA_SYNC_MODE=disabled
LOCAL_ARCHIVE_DIR=data_archive
LOCAL_ARCHIVE_EXPORT_DIR=data_archive/exports
DEMO_HISTORY_SEED_ENABLED=false

CANLII_DATABASE_PAGES=https://www.canlii.org/en/on/onca/,https://www.canlii.org/en/on/onsc/
CANLII_REMOTE_DATABASE_PAGE_LIMIT=80
CANLII_DATABASE_DISCOVERY_TTL_SECONDS=21600
CANLII_HTTP_PROXY=
CANLII_REQUEST_DELAY_SECONDS=2.0
CANLII_CASE_TEXT_CHAR_LIMIT=6000
CANLII_API_KEY=
CANLII_API_BASE_URL=http://api.canlii.org/v1
CANLII_API_PAGE_SIZE=100
CANLII_REALTIME_SEARCH_ENABLED=false
CANLII_REALTIME_SEARCH_MAX_ITEMS=20
KEYWORD_EXTRACTION_USE_LLM=true
PIPELINE_SEARCH_TIMEOUT_SECONDS=30
CANADA_FEDERAL_SYNC_MAX_ITEMS=0
ONTARIO_LEGISLATION_SYNC_MAX_ITEMS=0
ONTARIO_LEGISLATION_INCLUDE_FULL_TEXT=false
CANADA_LEGISLATION_SOURCE=laws_lois_xml
CANADA_CASE_SOURCE=a2aj_hf
A2AJ_API_BASE_URL=https://api.a2aj.ca
A2AJ_HF_CASE_DATASET=a2aj/canadian-case-law
A2AJ_HF_LAW_DATASET=a2aj/canadian-laws
A2AJ_DEMO_CASE_CONFIGS=default
A2AJ_DEMO_LAW_CONFIGS=default
A2AJ_DEMO_CASES_PER_CONFIG=5
A2AJ_DEMO_LAWS_PER_CONFIG=5
LAWS_LOIS_XML_REPO_URL=https://github.com/justicecanada/laws-lois-xml.git
LAWS_LOIS_XML_LOCAL_DIR=data/imports/laws-lois-xml
LAWS_LOIS_XML_DEMO_LIMIT=10

OFAC_FULL_SNAPSHOT_ENABLED=true
OFAC_SDN_CSV_URL=
OFAC_ADD_CSV_URL=
OFAC_ALT_CSV_URL=
OFAC_SDN_COMMENTS_CSV_URL=

# Choose exactly one: spark, openai, custom.
LLM_PROVIDER=custom

# OpenAI or OpenAI-compatible remote endpoint.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_REASONING_EFFORT=low

# Xunfei Spark.
SPARK_API_KEY=
SPARK_API_SECRET=
SPARK_APP_ID=
SPARK_MODEL=Spark Ultra-32K
SPARK_DOMAIN=4.0Ultra
SPARK_BASE_URL=wss://spark-api.xf-yun.com/v4.0/chat
SPARK_TEMPERATURE=0.2

# Local or custom OpenAI-compatible endpoint, for example vLLM, Ollama, LM Studio, Xinference.
CUSTOM_API_KEY=
CUSTOM_MODEL=qwen3.8-27b
CUSTOM_BASE_URL=https://your-openai-compatible-endpoint.example/v1
CUSTOM_TEMPERATURE=0.1
CUSTOM_MAX_TOKENS=4096
CUSTOM_STRICT_JSON_MODE=true
CUSTOM_USE_LOCAL=false

INGESTION_WORKER_POLL_SECONDS=2
INGESTION_PAGE_POLL_SECONDS=3000
INGESTION_TASK_REQUEUE_COOLDOWN_SECONDS=900
INGESTION_WORKER_STALE_SECONDS=600
INGESTION_WORKER_NAME=
AGENT_WORKER_IN_PROCESS_ENABLED=true
AGENT_WORKER_POLL_SECONDS=0.8
AGENT_WORKER_STALE_SECONDS=900
AGENT_WORKER_NAME=

INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_EMAIL=
# 民事一审模拟庭审（确定性编排 + 隔离 Agent）
CIVIL_TRIAL_USER_TURN_TIMEOUT_SECONDS=300
CIVIL_TRIAL_WARNING_BEFORE_SECONDS=30
CIVIL_TRIAL_AGENT_CALL_TIMEOUT_SECONDS=30
CIVIL_TRIAL_AGENT_RETRY_COUNT=1
CIVIL_TRIAL_OPPONENT_TOOL_LIMIT=3
CIVIL_TRIAL_OPPONENT_MAX_TOKENS=500
CIVIL_TRIAL_PROCEDURE_MAX_TOKENS=800
CIVIL_TRIAL_ADJUDICATION_MAX_TOKENS=2400
CIVIL_TRIAL_EVIDENCE_EXCHANGE_ROUNDS=2
CIVIL_TRIAL_ISSUE_SUMMARY_ROUNDS=2
CIVIL_TRIAL_SIMPLE_DEBATE_ROUNDS=1
CIVIL_TRIAL_ORDINARY_DEBATE_ROUNDS=2
CIVIL_TRIAL_COMPLEX_DEBATE_ROUNDS=3
CIVIL_TRIAL_MAX_USER_TIMEOUTS=3
CIVIL_TRIAL_MAX_OPPONENT_FALLBACKS=5
CIVIL_TRIAL_MAX_TOTAL_TOKENS=30000
CIVIL_TRIAL_MAX_API_CALLS=80
CIVIL_TRIAL_JUDGMENT_RESERVE_CALLS=2
CIVIL_TRIAL_JUDGMENT_RESERVE_TOKENS=5000
CIVIL_TRIAL_BUDGET_WARNING_RATIO=0.8
CIVIL_TRIAL_PROCEDURE_MODEL=
CIVIL_TRIAL_OPPONENT_MODEL=
CIVIL_TRIAL_ADJUDICATION_MODEL=
